# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Configuração opcional do banco PostgreSQL local via Docker Compose.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/frameworks
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=frameworks
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
