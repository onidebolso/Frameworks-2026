# Copie este arquivo e preencha com suas credenciais do Supabase
# Este arquivo é usado APENAS para produção (docker-compose.prod.yml)
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Banco PostgreSQL do stack docker (opcional sobrescrever)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/frameworks
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=frameworks
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
